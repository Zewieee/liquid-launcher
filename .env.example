# Copy this file to `.env` (gitignored) or set these environment variables locally before building/testing.
# NEVER commit your real `.env`, keystore file, or passwords to Git.

# Required toolchain paths
JAVA_HOME=C:\Program Files\Eclipse Adoptium\jdk-17
ANDROID_HOME=C:\Users\<your-user>\AppData\Local\Android\Sdk
ANDROID_BUILD_TOOLS=35.0.0
ANDROID_PLATFORM=android-35
ANDROID_NDK_VERSION=27.2.12479018

# External apktool & decompiled base APK directory (supplied locally by user)
APKTOOL_JAR=C:\path\to\apktool.jar
APKTOOL_FRAMEWORK_DIR=C:\path\to\apktool-framework
BASE_WORK_DIR=.\work

# Signing keystore (keep outside the repository)
KEYSTORE_PATH=C:\path\to\your-signing.keystore
KEYSTORE_ALIAS=your_key_alias
KEYSTORE_PASS=change_me
KEY_PASS=change_me
# Optional: pin expected SHA-256 certificate digest (64 lowercase hex chars) to verify upgrades
# KEYSTORE_CERT_SHA256=

# Optional: ADB target for running on-device ART verification suites or ADB media bridge
TV_ADDR=192.168.1.100:5555
